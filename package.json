    "preview": "wrangler dev",
    "test:health": "node -e \"fetch('http://localhost:3000').then(r=>console.log('HTTP',r.status))\""
  },
  "devDependencies": {
    "wrangler": "^3.80.0"
  },
  "keywords": [
    "observability",
    "devops",
    "sre",
    "incidents",
    "cloudflare-pages"
  ],
